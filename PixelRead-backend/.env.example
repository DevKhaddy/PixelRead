# PixelRead — capture backend
# Copy this file to .env and fill in the values.

# HTTP port (default: 8787)
PORT=8787

# Public root used in screenshot url/markdown links.
# REQUIRED in production — set to your deployed API host.
# Example: PUBLIC_BASE_URL=https://pixelread-api.onrender.com
PUBLIC_BASE_URL=http://localhost:8787

# CORS origin for the frontend. Use * for public, or set to your frontend URL.
ALLOWED_ORIGIN=*

# How long captured PNGs stay on disk before cleanup (ms). Default: 24 hours.
SHOT_TTL_MS=86400000

# ImgBB API key (optional). When set, captures are uploaded to ImgBB and the
# markdown link becomes a permanent public URL (i.ibb.co), so the server
# doesn't need to be running 24/7. Get a free key at https://api.imgbb.com/
# IMGBB_API_KEY=
